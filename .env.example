# BUGNEXUS 2.0 — Environment Configuration
# Copy this file to `.env` and adjust values for local development.

# ---- Server ----
# Port for the API server (default: 4000)
PORT=4000

# Base URL of the frontend (used for CORS)
CLIENT_URL=http://localhost:5173

# JWT secret — CHANGE THIS for any non-local deployment.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Database ----
# SQLite is used for local development. For PostgreSQL, set:
# DATABASE_URL="postgresql://user:password@localhost:5432/bugnexus"
DATABASE_URL="file:./dev.db"

# ---- AI (optional) ----
# Leave empty to use the built-in rule-based AI assistant (no external calls).
# To enable an OpenAI-compatible provider, set:
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=rule-based
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ---- Security ----
# Rate limit window (ms) and max requests per window for auth endpoints
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=100
